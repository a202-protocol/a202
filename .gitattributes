# Line endings are normalised to LF in the repository and in the working tree,
# so that a fixture edited on Windows and a fixture edited on macOS produce the
# same diff. This is a readability rule, not a correctness one: the conformance
# runner hashes the re-serialised object rather than the bytes of the file, so
# a line ending cannot change a content hash.

* text=auto eol=lf

*.md   text eol=lf
*.json text eol=lf
*.py   text eol=lf diff=python
*.yml  text eol=lf
*.yaml text eol=lf
